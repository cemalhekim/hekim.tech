---
/**
 * LogoMarquee.astro
 * Two endless left-to-right strips of the logos in src/affiliations.ts. Each row renders
 * its list four times (two halves of two copies) and slides by half its width, so the
 * loop has no seam even on very wide screens. Logos are CSS masks sized to equal area
 * (compact marks capped in height), muted until hovered.
 */
import { AFFILIATION_ROWS } from "@affiliations"

type Props = { label: string }
const { label } = Astro.props

const AREA = 18 // em², area every logo gets
const MAX_H = 2.5 // em, cap for square-ish marks
const SECONDS_PER_ITEM = 3.2 // keeps the speed near 55 px/s whatever the row length

const rows = AFFILIATION_ROWS.map((row, i) => ({
  // the second row runs a little slower so the two never move in lockstep
  duration: `${(row.length * 2 * SECONDS_PER_ITEM * (i === 0 ? 1 : 1.2)).toFixed(0)}s`,
  items: [...row, ...row].map((a) => {
    if (!a.logo || !a.ratio) return a
    const h = Math.min(MAX_H, Math.sqrt(AREA / a.ratio)) * (a.scale ?? 1)
    return { ...a, h: h.toFixed(2), w: (h * a.ratio).toFixed(2) }
  }),
}))
const muted = "text-black/40 dark:text-white/45 group-hover:text-black dark:group-hover:text-white blend"
---

<section aria-label={label} class="py-12 md:py-16">
  <div class="label text-center">{label}</div>
  <div class="mx-auto mt-3 h-0.5 w-10 bg-accent"></div>
  <div class="mt-10 space-y-8 md:space-y-10 text-[13px] md:text-base">
    {rows.map((row) => (
      <div class="marquee">
        <div class="marquee-track" style={`--duration:${row.duration}`}>
          {[0, 1].map((copy) => (
            <ul class="marquee-set" aria-hidden={copy === 1 ? "true" : undefined}>
              {row.items.map((a) => (
                <li class="group flex items-center gap-[0.6em]" title={a.name}>
                  {"w" in a ? (
                    <span
                      role="img"
                      aria-label={a.name}
                      class="logo block shrink-0 bg-black/40 dark:bg-white/45 group-hover:bg-[var(--brand)] dark:group-hover:bg-white"
                      style={`--logo:url(/logos/${a.logo});--brand:${a.brand ?? "#000"};width:${a.w}em;height:${a.h}em`}
                    />
                  ) : (
                    <span class={`whitespace-nowrap text-[1.2em] font-bold tracking-tight ${muted}`}>{a.name}</span>
                  )}
                  {a.wordmark && (
                    <span aria-hidden="true" class={`whitespace-nowrap font-bold leading-[1.1] tracking-tight ${muted}`}>
                      <span class="block text-[1.15em]">{a.wordmark[0]}</span>
                      <span class="block text-[0.8em] font-semibold">{a.wordmark[1]}</span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
  }
  .marquee-track {
    display: flex;
    width: max-content;
    animation: marquee var(--duration) linear infinite;
  }
  .marquee-set {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 4em;
    padding-right: 4em;
  }
  .logo {
    -webkit-mask: var(--logo) center / contain no-repeat;
    mask: var(--logo) center / contain no-repeat;
    transition: background-color 300ms ease;
  }
  /* Content travels left to right: start one set-width to the left, end at 0 */
  @keyframes marquee {
    from { transform: translateX(-50%); }
    to { transform: translateX(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track { animation-play-state: paused; }
  }
</style>
