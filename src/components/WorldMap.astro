---
/**
 * WorldMap.astro
 * Build-time SVG world map. Land outlines come from world-atlas (Natural Earth,
 * public domain) projected with d3-geo at build time: a 110m layer for the whole
 * world plus a 50m layer clipped to the Europe–Gulf region for crisp coastlines
 * while zoomed in. The two are cross-faded before the zoom starts, while the
 * viewport still equals the region, so the fine layer's clip edge never shows. The SVG starts zoomed on that region; as the visitor scrolls,
 * a flight route is drawn between the cities I have worked in, then the viewBox
 * zooms out to the world and the places of remote colleagues and projects pop
 * burst in as orange dots, one per scroll step, nearest to Düsseldorf first, so
 * they are tied to the scroll position and cannot be skipped by scrolling fast.
 * The parent marks the scroll range with `data-route-track`
 * and the closing caption with `data-outro`. Set `data-progress` on the figure
 * to freeze a given progress (0..1), useful for screenshots. Below the md breakpoint
 * the region view is square (same Europe–Gulf width, taller) and the frame stretches
 * back to the world's aspect ratio while it zooms out.
 */
import { geoMercator, geoPath } from "d3-geo"
import { feature } from "topojson-client"
import land110 from "world-atlas/land-110m.json"
import land50 from "world-atlas/land-50m.json"
import type { Topology, GeometryCollection } from "topojson-specification"

type City = { name: string; lon: number; lat: number; note: string; dx: number; dy: number; anchor: "start" | "end" | "middle"; nolabel?: boolean }

const cities: City[] = [
  { name: "Düsseldorf", lon: 6.7735, lat: 51.2277, note: "Vodafone GmbH", dx: -10, dy: -8, anchor: "end" },
  { name: "Berlin", lon: 13.405, lat: 52.52, note: "TU Berlin, BAM", dx: 10, dy: -8, anchor: "start" },
  { name: "Milan", lon: 9.19, lat: 45.4642, note: "Politecnico di Milano", dx: -10, dy: 14, anchor: "end" },
  { name: "Istanbul", lon: 28.9784, lat: 41.0082, note: "Mercedes-Benz", dx: -10, dy: -8, anchor: "end" },
  { name: "Kocaeli", lon: 29.9408, lat: 40.7654, note: "Koç Automotive", dx: 10, dy: 4, anchor: "start" },
  { name: "Izmir", lon: 27.1428, lat: 38.4237, note: "Vareint GmbH", dx: -10, dy: 14, anchor: "end" },
  { name: "Dubai / Abu Dhabi", lon: 55.2708, lat: 25.2048, note: "Vareint GmbH", dx: 10, dy: -6, anchor: "start" },
  { name: "Abu Dhabi", lon: 54.3773, lat: 24.4539, note: "", dx: 0, dy: 0, anchor: "end", nolabel: true },
]

// Flight route, in travel order
const routeOrder = ["Istanbul", "Dubai / Abu Dhabi", "Abu Dhabi", "Izmir", "Kocaeli", "Berlin", "Milan", "Düsseldorf"]

// Colleagues and projects around the world, shown once the map zooms out
const world = [
  { name: "Barcelona", lon: 2.1734, lat: 41.3851 },
  { name: "Munich", lon: 11.582, lat: 48.1351 },
  { name: "Mannheim", lon: 8.466, lat: 49.4875 },
  { name: "Warsaw", lon: 21.0122, lat: 52.2297 },
  { name: "Stockholm", lon: 18.0686, lat: 59.3293 },
  { name: "Trondheim", lon: 10.3951, lat: 63.4305 },
  { name: "Tehran", lon: 51.389, lat: 35.6892 },
  { name: "Kabul", lon: 69.2075, lat: 34.5553 },
  { name: "New Delhi", lon: 77.209, lat: 28.6139 },
  { name: "Beijing", lon: 116.4074, lat: 39.9042 },
  { name: "Taipei", lon: 121.5654, lat: 25.033 },
  { name: "California", lon: -122.4194, lat: 37.7749 },
  { name: "Texas", lon: -97.7431, lat: 30.2672 },
  { name: "New York", lon: -74.006, lat: 40.7128 },
  { name: "Toronto", lon: -79.3832, lat: 43.6532 },
  { name: "Bogotá", lon: -74.0721, lat: 4.711 },
  { name: "Cape Town", lon: 18.4241, lat: -33.9249 },
]

// World canvas in SVG user units; the rendered element is about 1000 px wide
const W = 4800
const H = 2600

// Full 360° of longitude across W; the top edge sits at 74° N so Antarctica falls off the bottom.
// (fitExtent cannot be used here: a polygon wider than a hemisphere is read as its complement.)
const mercScale = W / (2 * Math.PI)
const yAtTop = mercScale * Math.log(Math.tan(Math.PI / 4 + (74 * Math.PI) / 360))
const projection = geoMercator().scale(mercScale).translate([W / 2, yAtTop])
projection.clipExtent([[0, 0], [W, H]])
const path = geoPath(projection)

const t110 = land110 as unknown as Topology<{ land: GeometryCollection }>
const worldPath = path(feature(t110, t110.objects.land)) ?? ""

// Region of interest, Western Europe to the Gulf, as a viewBox with the world's aspect ratio
const rTL = projection([-11, 59]) ?? [0, 0]
const rBR = projection([61, 19]) ?? [W, H]
const regionH = (rBR[1] - rTL[1]) * 1.04
const regionW = regionH * (W / H)
const regionCX = (rTL[0] + rBR[0]) / 2
const regionCY = (rTL[1] + rBR[1]) / 2
const region = [regionCX - regionW / 2, regionCY - regionH / 2, regionW, regionH].map((v) => Math.round(v))
// Square region for mobile: same width, taller
const regionSq = [regionCX - regionW / 2, regionCY - regionW / 2, regionW, regionW].map((v) => Math.round(v))

// 50m coastline only inside the region (plus margin) to keep the HTML small; the clip
// covers the taller mobile square too, so its edge never shows before the cross-fade
const clipTop = Math.min(region[1], regionSq[1]) - 80
const clipBottom = Math.max(region[1] + region[3], regionSq[1] + regionSq[3]) + 80
const fineProjection = geoMercator().scale(mercScale).translate([W / 2, yAtTop])
fineProjection.clipExtent([[region[0] - 80, Math.max(0, clipTop)], [region[0] + region[2] + 80, Math.min(H, clipBottom)]])
const t50 = land50 as unknown as Topology<{ land: GeometryCollection }>
const finePath = geoPath(fineProjection)(feature(t50, t50.objects.land)) ?? ""

// Radius of 30 km at each city's latitude, in user units
const EARTH_R_KM = 6371
function radiusUnits(lon: number, lat: number, km: number): number {
  const dLat = (km / EARTH_R_KM) * (180 / Math.PI)
  const a = projection([lon, lat])
  const b = projection([lon, lat + dLat])
  if (!a || !b) return 2
  return Math.hypot(b[0] - a[0], b[1] - a[1])
}

const marks = cities.map((c) => {
  const p = projection([c.lon, c.lat]) ?? [0, 0]
  return { ...c, x: p[0], y: p[1], r30: radiusUnits(c.lon, c.lat, 30) }
})
// Great-circle distance from Düsseldorf, so the dots appear from near to far
const home = cities[0]
const rad = Math.PI / 180
const distKm = (lon: number, lat: number) =>
  EARTH_R_KM * Math.acos(Math.min(1, Math.sin(home.lat * rad) * Math.sin(lat * rad) + Math.cos(home.lat * rad) * Math.cos(lat * rad) * Math.cos((lon - home.lon) * rad)))
const dots = world
  .map((c) => {
    const p = projection([c.lon, c.lat]) ?? [0, 0]
    return { ...c, x: p[0], y: p[1], km: distKm(c.lon, c.lat) }
  })
  .sort((a, b) => a.km - b.km)

// Route as quadratic arcs bulging to the left of the travel direction
const byName = new Map(marks.map((m) => [m.name, m]))
const stops = routeOrder.map((n) => byName.get(n)).filter((m): m is NonNullable<typeof m> => !!m)
let routeD = `M ${stops[0].x.toFixed(1)} ${stops[0].y.toFixed(1)}`
for (let i = 1; i < stops.length; i++) {
  const a = stops[i - 1]
  const b = stops[i]
  const dx = b.x - a.x
  const dy = b.y - a.y
  const len = Math.hypot(dx, dy) || 1
  const bulge = Math.min(0.22 * len, 34)
  const cx = (a.x + b.x) / 2 - (dy / len) * bulge
  const cy = (a.y + b.y) / 2 + (dx / len) * bulge
  routeD += ` Q ${cx.toFixed(1)} ${cy.toFixed(1)} ${b.x.toFixed(1)} ${b.y.toFixed(1)}`
}
---

<figure class="card overflow-hidden" data-worldmap data-route-order={routeOrder.join("|")} data-region={region.join(" ")} data-world={`0 0 ${W} ${H}`} data-region-sq={regionSq.join(" ")}>
  <svg viewBox={region.join(" ")} class="block w-full h-auto max-md:aspect-square" role="img" aria-label="World map with the cities I have worked in, a flight route between them, and the places of colleagues and projects around the world">
    <defs>
      <radialGradient id="halo">
        <stop offset="0%" stop-color="rgb(var(--accent))" stop-opacity="0.85" />
        <stop offset="35%" stop-color="rgb(var(--accent))" stop-opacity="0.35" />
        <stop offset="100%" stop-color="rgb(var(--accent))" stop-opacity="0" />
      </radialGradient>
      <radialGradient id="halo-warm">
        <stop offset="0%" stop-color="rgb(var(--warn))" stop-opacity="0.9" />
        <stop offset="40%" stop-color="rgb(var(--warn))" stop-opacity="0.3" />
        <stop offset="100%" stop-color="rgb(var(--warn))" stop-opacity="0" />
      </radialGradient>
      <pattern id="mapgrid" width="200" height="200" patternUnits="userSpaceOnUse">
        <path d="M 200 0 L 0 0 0 200" fill="none" class="stroke-black/10 dark:stroke-white/10" stroke-width="2" vector-effect="non-scaling-stroke" />
      </pattern>
    </defs>

    <rect width={W} height={H} fill="url(#mapgrid)" />
    <path d={worldPath} class="coarse fill-[#e3e7ec] dark:fill-[#1f252d] stroke-black/25 dark:stroke-white/20" style="opacity: 0" stroke-width="0.6" vector-effect="non-scaling-stroke" />
    <path d={finePath} class="fine fill-[#e3e7ec] dark:fill-[#1f252d] stroke-black/30 dark:stroke-white/25" stroke-width="0.6" vector-effect="non-scaling-stroke" />

    <!-- Flight route: faint full path underneath, drawn part on top -->
    <path d={routeD} fill="none" class="stroke-accent/20 route-faint" stroke-width="1" stroke-dasharray="3 5" />
    <path d={routeD} fill="none" class="stroke-accent route" stroke-width="1.6" stroke-linecap="round" />

    <g class="cities">
      {marks.map((m) => (
        <g class="city" data-city={m.name}>
          <circle cx={m.x} cy={m.y} r={m.r30 * 5} fill="url(#halo)" class="halo" data-r={m.r30 * 5} />
          <circle cx={m.x} cy={m.y} r={m.r30} class="fill-accent core" data-r={m.r30} />
          {!m.nolabel && (
            <text x={m.x + m.dx} y={m.y + m.dy} text-anchor={m.anchor} class="font-mono fill-black dark:fill-white" font-size="15">{m.name}</text>
          )}
          {m.note && (
            <text x={m.x + m.dx} y={m.y + m.dy + 13} text-anchor={m.anchor} class="font-mono fill-black/50 dark:fill-white/50" font-size="10.5">{m.note}</text>
          )}
        </g>
      ))}
    </g>

    <!-- Colleagues and projects around the world -->
    <g class="dots">
      {dots.map((d) => (
        <g class="dot" transform={`translate(${d.x.toFixed(1)} ${d.y.toFixed(1)})`}>
          <title>{d.name}</title>
          <circle r="110" fill="url(#halo-warm)" class="burst" />
          <circle r="16" class="fill-warn core" />
        </g>
      ))}
    </g>

    <!-- Plane, moved along the route by the script -->
    <g class="plane" style={`transform: translate(${stops[0].x}px, ${stops[0].y}px)`}>
      <path d="M 9 0 L -5 -5 L -3 0 L -5 5 Z" class="fill-accent" />
    </g>
  </svg>
</figure>

<style>
  .halo {
    transform-box: fill-box;
    transform-origin: center;
    animation: halo-pulse 3.2s ease-in-out infinite;
  }
  .city:nth-child(2n) .halo { animation-delay: -1.1s; }
  .city:nth-child(3n) .halo { animation-delay: -2.2s; }
  @keyframes halo-pulse {
    0%, 100% { transform: scale(1); opacity: 0.9; }
    50% { transform: scale(1.35); opacity: 0.55; }
  }
  .city { transition: opacity 400ms ease; }
  .city.pending { opacity: 0.35; }
  .fine, .coarse, .route, .route-faint, .cities text { transition: opacity 300ms linear; }
  .cities.labels-off text { opacity: 0; }
  .plane { transform-box: view-box; will-change: transform; }

  /* Orange dots start invisible; the script sets opacity and scale from the scroll position */
  .dot .core, .dot .burst { opacity: 0; transform-box: fill-box; transform-origin: center; }
  @media (prefers-reduced-motion: reduce) {
    .halo { animation: none; }
  }
</style>

<script>
  function initRoute() {
    const fig = document.querySelector<HTMLElement>("[data-worldmap]")
    if (!fig || fig.dataset.ready === "1") return
    fig.dataset.ready = "1"
    const svg = fig.querySelector("svg")
    const route = fig.querySelector<SVGPathElement>("path.route")
    const plane = fig.querySelector<SVGGElement>("g.plane")
    const citiesG = fig.querySelector<SVGGElement>("g.cities")
    const fine = fig.querySelector<SVGPathElement>("path.fine")
    const coarse = fig.querySelector<SVGPathElement>("path.coarse")
    const routeFaint = fig.querySelector<SVGPathElement>("path.route-faint")
    const discs = Array.from(fig.querySelectorAll<SVGCircleElement>("g.city circle[data-r]"))
    const track = fig.closest<HTMLElement>("[data-route-track]")
    const outro = track?.querySelector<HTMLElement>("[data-outro]") ?? null
    if (!svg || !route || !plane || !citiesG || !fine) return

    const box = (v?: string) => (v ?? "").split(" ").map(Number)
    const square = window.matchMedia("(max-width: 767px)")
    let region = box(fig.dataset.region)
    const worldBox = box(fig.dataset.world)
    const pickBoxes = () => {
      region = box(square.matches ? fig.dataset.regionSq : fig.dataset.region)
    }
    pickBoxes()
    svg.setAttribute("viewBox", region.join(" "))
    const total = route.getTotalLength()
    route.style.strokeDasharray = `${total}`
    const cities = Array.from(fig.querySelectorAll<SVGGElement>("g.city"))
    const dots = Array.from(fig.querySelectorAll<SVGGElement>("g.dot"))
    const order = (fig.dataset.routeOrder ?? "").split("|")

    // Distance along the path at which each city is reached, for lighting labels up
    const cityAt = new Map<string, number>()
    const samples = 400
    for (const g of cities) {
      const name = g.dataset.city ?? ""
      if (!order.includes(name)) continue
      const c = g.querySelectorAll("circle")[1]
      if (!c) continue
      const cx = +(c.getAttribute("cx") ?? 0)
      const cy = +(c.getAttribute("cy") ?? 0)
      let best = 0
      let bestD = Infinity
      for (let i = 0; i <= samples; i++) {
        const at = (total * i) / samples
        const p = route.getPointAtLength(at)
        const d = Math.hypot(p.x - cx, p.y - cy)
        if (d < bestD) {
          bestD = d
          best = at
        }
      }
      cityAt.set(name, best)
    }

    const clamp = (v: number) => Math.min(1, Math.max(0, v))
    const easeInOut = (t: number) => (t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2)
    const ROUTE_END = 0.5 // share of the scroll spent drawing the route
    const ZOOM_START = 0.55
    const ZOOM_END = 0.8
    const DOTS_END = 0.96 // dots burst in one after another between ZOOM_END and here
    const DOT_WINDOW = 0.035 // scroll share over which a single dot goes from nothing to settled
    const easeOutBack = (t: number) => 1 + 2.7 * Math.pow(t - 1, 3) + 1.7 * Math.pow(t - 1, 2)
    const dotParts = dots.map((d) => ({ core: d.querySelector<SVGCircleElement>(".core"), burst: d.querySelector<SVGCircleElement>(".burst") }))

    function render(p: number) {
      if (!svg || !route || !plane || !citiesG || !fine) return
      // Phase 1: route
      const p1 = clamp(p / ROUTE_END)
      const len = total * p1
      route.style.strokeDashoffset = `${total - len}`
      const pt = route.getPointAtLength(len)
      const ahead = route.getPointAtLength(Math.min(total, len + 2))
      const ang = (Math.atan2(ahead.y - pt.y, ahead.x - pt.x) * 180) / Math.PI
      plane.style.transform = `translate(${pt.x}px, ${pt.y}px) rotate(${ang}deg)`
      plane.style.opacity = p1 > 0.995 ? "0" : "1"
      for (const g of cities) {
        const at = cityAt.get(g.dataset.city ?? "")
        if (at === undefined) continue
        g.classList.toggle("pending", len < at - 1)
      }

      // Between route and zoom: swap the fine regional coastline for the coarse world one
      // while the view still equals the region, so the fine layer's clip edge is never visible.
      const swap = clamp((p - ROUTE_END) / (ZOOM_START - ROUTE_END))
      fine.style.opacity = `${1 - swap}`
      if (coarse) coarse.style.opacity = `${swap}`

      // Phase 2: zoom out to the world
      const q = easeInOut(clamp((p - ZOOM_START) / (ZOOM_END - ZOOM_START)))
      // Interpolate the viewBox width geometrically so the zoom feels linear
      const w = region[2] * Math.pow(worldBox[2] / region[2], q)
      const h = region[3] * Math.pow(worldBox[3] / region[3], q)
      const cx = region[0] + region[2] / 2 + (worldBox[0] + worldBox[2] / 2 - (region[0] + region[2] / 2)) * q
      const cy = region[1] + region[3] / 2 + (worldBox[1] + worldBox[3] / 2 - (region[1] + region[3] / 2)) * q
      svg.setAttribute("viewBox", `${(cx - w / 2).toFixed(1)} ${(cy - h / 2).toFixed(1)} ${w.toFixed(1)} ${h.toFixed(1)}`)
      // The frame follows the view box: square region on mobile → wide world while zooming out
      svg.style.aspectRatio = `${w.toFixed(1)} / ${h.toFixed(1)}`
      // Keep line widths visually constant while the viewBox grows
      const zoom = w / region[2]
      route.setAttribute("stroke-width", `${1.6 * zoom}`)
      routeFaint?.setAttribute("stroke-width", `${1 * zoom}`)
      routeFaint?.setAttribute("stroke-dasharray", `${3 * zoom} ${5 * zoom}`)
      // Zoomed out: hide the route and labels, keep the discs and grow them so they stay visible
      const fade = `${1 - clamp(q * 1.6)}`
      route.style.opacity = fade
      if (routeFaint) routeFaint.style.opacity = fade
      citiesG.classList.toggle("labels-off", q > 0.25)
      const grow = 1 + 2.5 * q
      for (const c of discs) c.setAttribute("r", `${+(c.dataset.r ?? 1) * grow}`)

      // Phase 3: colleagues and projects burst in one by one, each at its own scroll position
      const stepEvery = (DOTS_END - DOT_WINDOW - ZOOM_END) / Math.max(1, dotParts.length - 1)
      dotParts.forEach(({ core, burst }, i) => {
        const t = clamp((p - (ZOOM_END + i * stepEvery)) / DOT_WINDOW)
        if (core) {
          core.style.opacity = `${clamp(t * 2)}`
          core.style.transform = `scale(${t === 0 ? 0.2 : 0.2 + 0.8 * easeOutBack(t)})`
        }
        if (burst) {
          // flash up to 1.4× at 30 %, then settle to a soft glow
          burst.style.opacity = `${t < 0.3 ? t / 0.3 : 1 - 0.45 * ((t - 0.3) / 0.7)}`
          burst.style.transform = `scale(${t < 0.3 ? 0.3 + (1.1 * t) / 0.3 : 1.4 - (0.4 * (t - 0.3)) / 0.7})`
        }
      })
      outro?.classList.toggle("is-on", p >= DOTS_END)
    }

    const forced = fig.dataset.progress
    if (forced !== undefined) {
      render(+forced)
      return
    }
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches
    if (reduce || !track) {
      render(1)
      return
    }
    const trackEl: HTMLElement = track

    let raf = 0
    function onScroll() {
      cancelAnimationFrame(raf)
      raf = requestAnimationFrame(() => {
        const rect = trackEl.getBoundingClientRect()
        const span = rect.height - window.innerHeight
        const p = span <= 0 ? 1 : clamp(-rect.top / span)
        render(p)
      })
    }
    window.addEventListener("scroll", onScroll, { passive: true })
    window.addEventListener("resize", onScroll)
    square.addEventListener("change", () => {
      pickBoxes()
      onScroll()
    })
    onScroll()
  }

  initRoute()
  document.addEventListener("astro:after-swap", initRoute)
</script>
