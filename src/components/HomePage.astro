---
/**
 * HomePage.astro
 * The home page, rendered once per language by src/pages/index.astro and
 * src/pages/[lang]/index.astro. All copy comes from src/i18n.ts.
 */
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import ArrowCard from "@components/ArrowCard"
import RobotHero from "@components/RobotHero.astro"
import WorldMap from "@components/WorldMap.astro"
import LogoMarquee from "@components/LogoMarquee.astro"
import Stats from "@components/Stats.astro"
import { AFFILIATION_ROWS } from "@affiliations"
import { personJsonLd } from "@lib/jsonld"
import { PUBLICATIONS } from "@publications"
import { SOCIALS } from "@consts"
import { Icon } from "astro-icon/components"
import { DICT, localePath, type Lang } from "@i18n"
import { STACK } from "@stack"

type Props = { lang: Lang }
const { lang } = Astro.props
const t = DICT[lang]
const worldCities = "Barcelona, Munich, Mannheim, Warsaw, Stockholm, Trondheim, Tehran, Kabul, New Delhi, Beijing, Taipei, California, Texas, New York, Toronto, Bogotá, Cape Town"

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4)

const capabilities = [
  { code: "01", icon: "lucide:bot", tags: ["ROS 2", "DDS", "MuJoCo", "MoveIt"] },
  { code: "02", icon: "lucide:factory", tags: ["ABB", "KUKA", "Microcontrollers", "Vision"] },
  { code: "03", icon: "lucide:brain-circuit", tags: ["Claude", "Local LLMs", "MCP", "Speech"] },
  { code: "04", icon: "lucide:server", tags: ["FreeCAD", "TypeScript", "Docker", "Caddy"] },
].map((c, i) => ({ ...c, ...t.home.caps[i] }))


// Robots I have worked with, by class
const robots = [
  { group: t.home.robotGroups.industrial, items: ["ABB IRB 6700", "ABB IRB 6640", "KUKA KR 16 R2010"] },
  { group: t.home.robotGroups.cobots, items: ["Universal Robots UR10e", "Universal Robots UR5e", "Franka Emika Panda", "UFactory xArm 6", "NEURA LARA 3"] },
  { group: t.home.robotGroups.humanoids, items: ["Unitree H1-2", "SoftBank Pepper", "SoftBank NAO"] },
  { group: t.home.robotGroups.own, items: ["Wall-crawling robot", "Autonomous zeppelin", "Self-driving electrochemistry lab", "SunTide offshore-corrosion simulator"] },
]

// Numbers band. 28 days = longest unattended ltms run at BAM (vault Resume/BAM Lab Automation, ## Numbers);
// the 3 countries are Germany, Türkiye and the UAE from the work entries.
const roles = (await getCollection("work")).length
const stats = [
  { value: AFFILIATION_ROWS.flat().length, label: t.home.numbers.orgs },
  { value: robots.filter((r) => r.group !== t.home.robotGroups.own).reduce((n, r) => n + r.items.length, 0), label: t.home.numbers.robots },
  { value: 28, suffix: t.home.numbers.daysUnit, label: t.home.numbers.days },
  { value: roles, label: t.home.numbers.roles },
]

const publications = [...PUBLICATIONS].sort((a, b) => b.year.localeCompare(a.year))

// "Book a call" opens a prefilled mail; a booking service would be the only other way
const callHref = `mailto:cemal@hekim.tech?subject=${encodeURIComponent(t.home.callSubject)}&body=${encodeURIComponent(t.home.callBody)}`
---

<PageLayout title={t.home.title} description={t.home.lead} lang={lang}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(personJsonLd(lang, new URL(Astro.url.pathname, Astro.site).href))} />

  <!-- HERO -->
  <section class="relative h-[100svh] min-h-[560px] max-h-[960px] w-full">
    <RobotHero />

    <!-- Scanline sweep, dark only -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 hidden dark:block overflow-hidden">
      <div class="absolute inset-x-0 h-24 bg-gradient-to-b from-transparent via-accent/[0.06] to-transparent animate-scan"></div>
    </div>

    <div class="animate absolute inset-0 flex items-center">
      <div class="mx-auto w-full max-w-screen-lg px-5 pt-16">
        <div class="max-w-xl">
          <a href="#contact" class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 py-1 pl-2.5 pr-3 text-xs md:text-sm text-black dark:text-white hover:border-accent blend">
            <span class="status-dot"></span>
            <span>{t.home.availability}</span>
            <span aria-hidden="true" class="text-accent">→</span>
          </a>
          <div class="mt-4 label">{t.home.eyebrow}</div>
          <h1 class="mt-3 text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.05] text-black dark:text-white">
            {t.home.h1}
          </h1>
          <p class="mt-5 text-base md:text-lg max-w-md">
            {t.home.lead}
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href={callHref} class="btn btn-primary">
              {t.home.ctaCall}
              <svg class="size-4 stroke-current" fill="none" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <a href="/projects" class="btn btn-secondary">{t.home.ctaProjects}</a>
            <a href={localePath(lang, "/history/")} class="btn btn-secondary">{t.home.ctaWork}</a>
          </div>
        </div>
      </div>
    </div>

    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-b from-transparent to-[rgb(var(--bg))]"></div>
  </section>

  <!-- Companies and institutions, endless logo strip -->
  <LogoMarquee label={t.home.logosLabel} />
  <Stats label={t.home.numbersLabel} stats={stats} />

  <div class="relative">
    <div class="mx-auto max-w-screen-lg px-5 space-y-28 pb-24">

      <!-- About -->
      <section class="animate grid gap-8 md:grid-cols-[180px_1fr]">
        <div>
          <div class="label">{t.home.aboutLabel}</div>
          <div class="mt-2 font-mono text-xs text-black/50 dark:text-white/50">
            <div>Berlin · Düsseldorf</div>
            <div>EN · DE · TR</div>
          </div>
        </div>
        <article class="!pb-0">
          {t.home.about.map((p) => <p set:html={p} />)}
        </article>
      </section>

      <!-- Capabilities -->
      <section class="animate">
        <div class="label">{t.home.whatLabel}</div>
        <h2 class="mt-2 text-2xl md:text-3xl font-bold text-black dark:text-white">{t.home.whatTitle}</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {capabilities.map((c) => (
            <div class="card p-5">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="inline-flex size-8 items-center justify-center rounded border border-accent/30 bg-accent/10 text-accent">
                    <Icon name={c.icon} class="size-4" />
                  </span>
                  <div class="font-mono text-xs text-accent">{c.code}</div>
                </div>
                <div class="font-mono text-[10px] uppercase tracking-widest text-black/40 dark:text-white/40">{t.home.module}</div>
              </div>
              <div class="mt-3 font-semibold text-black dark:text-white">{c.title}</div>
              <p class="mt-2 text-sm">{c.text}</p>
              <ul class="mt-4 flex flex-wrap gap-1">
                {c.tags.map((t) => <li class="chip">{t}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- International Sailor: pinned while the flight route draws -->
      <section class="animate" data-route-track>
        <div class="h-[500vh]">
          <div class="sticky top-20">
            <div class="label">{t.home.intlLabel}</div>
            <h2 class="mt-2 text-2xl md:text-3xl font-bold text-black dark:text-white">{t.home.intlTitle}</h2>
            <p class="mt-3 max-w-2xl">{t.home.intlText}</p>
            <div class="mt-6">
              <WorldMap />
            </div>
            <p data-outro class="outro mt-4 max-w-2xl flex items-start gap-2">
              <span class="mt-1.5 inline-block size-2 shrink-0 rounded-full bg-warn"></span>
              <span>{t.home.outro.replace("{cities}", worldCities)}</span>
            </p>
          </div>
        </div>
      </section>

      <!-- Projects -->
      <section class="animate">
        <div class="flex items-end justify-between gap-4">
          <div>
            <div class="label">{t.home.projectsLabel}</div>
            <h2 class="mt-2 text-2xl md:text-3xl font-bold text-black dark:text-white">{t.home.projectsTitle}</h2>
          </div>
          <a href="/projects" class="font-mono text-xs uppercase tracking-wider text-black/60 dark:text-white/60 hover:text-accent blend">{t.home.allProjects}</a>
        </div>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {projects.map((project) => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>

      <!-- Publications and talks -->
      <section class="animate">
        <div class="label">{t.home.pubsLabel}</div>
        <h2 class="mt-2 text-2xl md:text-3xl font-bold text-black dark:text-white">{t.home.pubsTitle}</h2>
        <ol class="mt-6 divide-y divide-black/10 dark:divide-white/10 border-y border-black/10 dark:border-white/10">
          {publications.map((p) => (
            <li class="grid gap-2 py-4 md:grid-cols-[120px_1fr] md:gap-3">
              <div class="font-mono text-[11px] uppercase tracking-wider text-accent pt-1">{p.year}</div>
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <span class="chip">{t.home.pubKinds[p.kind]}</span>
                  <span class="font-mono text-xs text-black/50 dark:text-white/50">{p.venue}</span>
                </div>
                {p.href ? (
                  <a href={p.href} target="_blank" rel="noopener" class="mt-2 block font-semibold text-black dark:text-white hover:text-accent blend">{p.title} <span aria-hidden="true" class="text-accent">↗</span></a>
                ) : (
                  <div class="mt-2 font-semibold text-black dark:text-white">{p.title}</div>
                )}
                <p class="mt-1 text-sm">{p.note[lang]}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <!-- Stack and robots -->
      <section class="animate grid gap-14">
        <div>
          <div class="label">{t.home.stackLabel}</div>
          <h2 class="mt-2 text-2xl md:text-3xl font-bold text-black dark:text-white">{t.home.stackTitle}</h2>
          <dl class="mt-6 divide-y divide-black/10 dark:divide-white/10 border-y border-black/10 dark:border-white/10">
            {STACK.map((g) => (
              <div class="grid grid-cols-[120px_1fr] gap-3 py-3">
                <dt class="font-mono text-[11px] uppercase tracking-wider text-accent pt-1">{t.home.stackGroups[g.key]}</dt>
                <dd class="flex flex-wrap gap-1.5">
                  {g.items.map((item) => (
                    <span class="chip inline-flex items-center gap-1.5 !text-xs !normal-case !tracking-normal py-1 px-2.5 text-black dark:text-white hover:border-accent hover:text-accent blend">
                      {item.icon.startsWith("/") ? <img src={item.icon} alt="" width="14" height="14" class="size-3.5 rounded-sm" loading="lazy" /> : <Icon name={item.icon} class="size-3.5" />}
                      {item.name}
                    </span>
                  ))}
                </dd>
              </div>
            ))}
          </dl>
        </div>
        <div>
          <div class="label">{t.home.robotsLabel}</div>
          <h2 class="mt-2 text-2xl md:text-3xl font-bold text-black dark:text-white">{t.home.robotsTitle}</h2>
          <dl class="mt-6 divide-y divide-black/10 dark:divide-white/10 border-y border-black/10 dark:border-white/10">
            {robots.map((r) => (
              <div class="grid grid-cols-[120px_1fr] gap-3 py-3">
                <dt class="font-mono text-[11px] uppercase tracking-wider text-accent pt-1">{r.group}</dt>
                <dd class="flex flex-wrap gap-1.5">
                  {r.items.map((name) => (
                    <span class="chip !text-xs !normal-case !tracking-normal py-1 px-3 text-black dark:text-white hover:border-accent hover:text-accent blend">{name}</span>
                  ))}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <!-- Contact -->
      <section id="contact" class="animate scroll-mt-24">
        <div class="card p-6 md:p-8 grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
          <div>
            <div class="label">{t.home.contactLabel}</div>
            <h2 class="mt-2 text-2xl md:text-3xl font-bold text-black dark:text-white">{t.home.contactTitle}</h2>
            <p class="mt-3 max-w-lg">{t.home.contactText}</p>
            <div class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-2">
              <a href={callHref} class="btn btn-primary">{t.home.ctaCall}</a>
              <span class="text-sm text-black/60 dark:text-white/60">{t.home.callNote}</span>
            </div>
            <div class="mt-4 flex items-center gap-2 font-mono text-xs text-black/60 dark:text-white/60">
              <span class="status-dot"></span>
              <span>{t.home.availability}</span>
            </div>
          </div>
          <div class="flex flex-col gap-2 font-mono text-sm">
            {SOCIALS.map(social => (
              <a href={social.HREF} target="_blank" class="group flex items-center gap-3 text-black/70 dark:text-white/70 hover:text-accent blend">
                <Icon name={social.ICON === "email" ? "lucide:mail" : `simple-icons:${social.ICON}`} class="size-4 text-black/40 dark:text-white/40 group-hover:text-accent blend" />
                <span class="w-16 text-[10px] uppercase tracking-widest text-black/40 dark:text-white/40 group-hover:text-accent/70">{social.NAME}</span>
                <span>{social.TEXT}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    </div>
  </div>
</PageLayout>
