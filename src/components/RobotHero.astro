---
/**
 * RobotHero.astro
 * Full-bleed Three.js scene with a Franka Emika Panda (FER + Franka Hand) loaded from its
 * URDF (public/robot/fer/fer.urdf, meshes from frankarobotics/franka_description). The arm
 * plays back a pick-and-place loop planned offline by scripts/robot-trajectory.mjs with IK
 * on the same URDF: movej above the cube, movel down, close the fingers on the cube, lift,
 * carry, set it down on the other pad, release. While gripped, the cube is parented to the
 * TCP link, so it moves exactly with the hand. Joint angles, gripper width and the TCP
 * position are streamed into the HUD. The scene pauses off-screen or in a hidden tab and
 * shows a single frame when the visitor prefers reduced motion. `?robotdebug` exposes the
 * scene on window.__heroRobot for the e2e check.
 */
---

<div id="robot-hero" class="absolute inset-0 overflow-hidden">
  <canvas id="robot-canvas" class="block h-full w-full opacity-0 transition-opacity duration-700" aria-hidden="true"></canvas>

  <!-- HUD: joint telemetry, desktop only -->
  <div class="pointer-events-none absolute bottom-6 left-5 hidden md:block font-mono text-[11px] leading-5 text-black/60 dark:text-white/60">
    <div class="label mb-1">Joint state · FER</div>
    <div class="grid grid-cols-[auto_1fr] gap-x-3">
      {[1, 2, 3, 4, 5, 6, 7].map((j) => (
        <>
          <span>J{j}</span>
          <span class="tabular-nums text-right" data-joint={j}>+000.0°</span>
        </>
      ))}
    </div>
  </div>

  <div class="pointer-events-none absolute bottom-6 right-5 hidden md:block font-mono text-[11px] leading-5 text-right text-black/60 dark:text-white/60">
    <div class="label mb-1">Tool pose</div>
    <div class="grid grid-cols-[auto_1fr] gap-x-3">
      <span>X</span><span class="tabular-nums" data-tcp="x">+0.000 m</span>
      <span>Y</span><span class="tabular-nums" data-tcp="y">+0.000 m</span>
      <span>Z</span><span class="tabular-nums" data-tcp="z">+0.000 m</span>
      <span>Grip</span><span class="tabular-nums" data-tcp="grip">80 mm</span>
    </div>
  </div>
</div>

<script>
  // The scene (three.js + glTF + trajectory) is a separate chunk, fetched after the page is up
  const run = () => import("../robot/hero").then((m) => m.init())
  run()
  document.addEventListener("astro:after-swap", run)
</script>
