---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import { WORK } from "@consts"

const byStart = (a: { data: { dateStart: Date } }, b: { data: { dateStart: Date } }) =>
  new Date(b.data.dateStart).getTime() - new Date(a.data.dateStart).getTime()

const work = await Promise.all(
  (await getCollection("work")).sort(byStart).map(async (item) => {
    const { Content } = await item.render()
    return { ...item, Content }
  })
)

const education = await Promise.all(
  (await getCollection("education")).sort(byStart).map(async (item) => {
    const { Content } = await item.render()
    return { ...item, Content }
  })
)

function formatDate(input: Date | string) {
  if (typeof input === "string") return input
  const month = input.toLocaleDateString("en-US", { month: "short" })
  return `${month} ${new Date(input).getFullYear()}`
}
---

<PageLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>
  <div class="pt-32 pb-5">
    <div class="mx-auto w-full max-w-screen-lg px-5">
      <div class="animate">
        <div class="label">Timeline</div>
        <h1 class="text-3xl font-semibold text-black dark:text-white mt-2">
          {WORK.TITLE}
        </h1>
        <div class="mt-1">
          {WORK.DESCRIPTION}
        </div>
      </div>
    </div>
  </div>

  <div class="flex-1 py-5">
    <div class="mx-auto w-full max-w-screen-lg px-5 grid gap-12 md:grid-cols-2">

      <!-- Work -->
      <section>
        <div class="animate label mb-6">Work</div>
        <ol class="relative border-l border-black/10 dark:border-white/15 ml-2">
          {
            work.map((entry, i) => (
              <li class="animate relative pl-8 pb-10 last:pb-0">
                <span class={`absolute -left-[5px] top-1.5 size-[9px] rounded-full ${i === 0 ? "bg-accent shadow-[0_0_0_4px_rgb(var(--accent)/0.2)]" : "bg-black/30 dark:bg-white/30"}`}></span>
                <div class="font-mono text-[11px] uppercase tracking-wider text-black/50 dark:text-white/50 mb-2">
                  {formatDate(entry.data.dateStart)} — {formatDate(entry.data.dateEnd)}
                </div>
                <div class="text-black dark:text-white font-semibold">
                  {entry.data.company}
                </div>
                <div class="text-sm text-accent">
                  {entry.data.role}
                </div>
                <article class="prose dark:prose-invert !pb-0 mt-2 text-sm">
                  <entry.Content />
                </article>
              </li>
            ))
          }
        </ol>
      </section>

      <!-- Education -->
      <section>
        <div class="animate label mb-6">Education</div>
        <ol class="relative border-l border-black/10 dark:border-white/15 ml-2">
          {
            education.map((entry, i) => (
              <li class={`animate relative pl-8 pb-10 last:pb-0 ${entry.data.muted ? "opacity-45" : ""}`}>
                <span class={`absolute -left-[5px] top-1.5 size-[9px] rounded-full ${i === 0 ? "bg-accent shadow-[0_0_0_4px_rgb(var(--accent)/0.2)]" : "bg-black/30 dark:bg-white/30"}`}></span>
                <div class="font-mono text-[11px] uppercase tracking-wider text-black/50 dark:text-white/50 mb-2">
                  {formatDate(entry.data.dateStart)} — {formatDate(entry.data.dateEnd)}
                </div>
                <div class="text-black dark:text-white font-semibold">
                  {entry.data.school}
                </div>
                <div class={`text-sm ${entry.data.muted ? "text-black/60 dark:text-white/60" : "text-accent"}`}>
                  {entry.data.degree}
                </div>
                <article class="prose dark:prose-invert !pb-0 mt-2 text-sm">
                  <entry.Content />
                </article>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </div>
</PageLayout>
