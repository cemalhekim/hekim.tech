---
import { getCollection } from "astro:content"
import PageLayout from "@layouts/PageLayout.astro"
import ArrowCard from "@components/ArrowCard"
import RobotHero from "@components/RobotHero.astro"
import WorldMap from "@components/WorldMap.astro"
import { SITE, SOCIALS } from "@consts"
import { Icon } from "astro-icon/components"

const posts = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4)

const capabilities = [
  {
    code: "01",
    icon: "lucide:bot",
    title: "Humanoids & manipulation",
    text: "Telemetry, teleoperation and control stacks for humanoids and arms: Unitree H1-2, Franka Panda, UR5e/UR10e, xArm.",
    tags: ["ROS 2", "DDS", "MuJoCo", "MoveIt"],
  },
  {
    code: "02",
    icon: "lucide:factory",
    title: "Lab & process automation",
    text: "Robot cells that run unattended: sample handling, 30-hour measurement campaigns, welding and QC lines.",
    tags: ["ABB", "KUKA", "Microcontrollers", "Vision"],
  },
  {
    code: "03",
    icon: "lucide:brain-circuit",
    title: "AI agents on real hardware",
    text: "LLM agents that plan tasks, drive devices and talk to people, from a bilingual Pepper to a lab-wide agent platform.",
    tags: ["Claude", "Local LLMs", "MCP", "Speech"],
  },
  {
    code: "04",
    icon: "lucide:server",
    title: "Tooling & infrastructure",
    text: "The stack around the robots: AI-assisted CAD, web dashboards, containers and the home server that serves this page.",
    tags: ["FreeCAD", "TypeScript", "Docker", "Caddy"],
  },
]

// Brand marks from Simple Icons (CC0) where one exists; the rest render as text.
const stack: { name: string; icon?: string }[] = [
  { name: "ROS 2", icon: "simple-icons:ros" },
  { name: "Python", icon: "simple-icons:python" },
  { name: "C++", icon: "simple-icons:cplusplus" },
  { name: "TypeScript", icon: "simple-icons:typescript" },
  { name: "PyTorch", icon: "simple-icons:pytorch" },
  { name: "YOLO", icon: "simple-icons:ultralytics" },
  { name: "OpenCV", icon: "simple-icons:opencv" },
  { name: "MuJoCo" },
  { name: "Gazebo" },
  { name: "MoveIt" },
  { name: "FreeCAD", icon: "simple-icons:freecad" },
  { name: "Docker", icon: "simple-icons:docker" },
  { name: "Linux", icon: "simple-icons:linux" },
  { name: "Caddy", icon: "simple-icons:caddy" },
  { name: "Tailscale", icon: "simple-icons:tailscale" },
  { name: "Claude & local LLMs", icon: "simple-icons:claude" },
]

// Robots I have worked with, by class
const robots = [
  { group: "Industrial arms", items: ["ABB IRB 6700", "ABB spot-welding robots", "KUKA"] },
  { group: "Cobots", items: ["Universal Robots UR10e", "Universal Robots UR5e", "Franka Emika Panda", "UFactory xArm"] },
  { group: "Humanoids", items: ["Unitree H1-2"] },
  { group: "Service robots", items: ["SoftBank Pepper"] },
  { group: "Own builds", items: ["Wall-crawling robot"] },
]
---

<PageLayout title="Home" description={SITE.DESCRIPTION}>

  <!-- HERO -->
  <section class="relative h-[100svh] min-h-[560px] max-h-[960px] w-full">
    <RobotHero />

    <!-- Scanline sweep, dark only -->
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 hidden dark:block overflow-hidden">
      <div class="absolute inset-x-0 h-24 bg-gradient-to-b from-transparent via-accent/[0.06] to-transparent animate-scan"></div>
    </div>

    <div class="animate absolute inset-0 flex items-center">
      <div class="mx-auto w-full max-w-screen-lg px-5 pt-16">
        <div class="max-w-xl">
          <div class="flex items-center gap-2 label">
            <span class="status-dot"></span>
            <span>Robotics // AI automation // Agents</span>
          </div>
          <h1 class="mt-4 text-4xl md:text-5xl lg:text-6xl font-bold leading-[1.05] text-black dark:text-white">
            I build robots and the AI that runs them.
          </h1>
          <p class="mt-5 text-base md:text-lg max-w-md">
            Cemal Hekim. Robotics engineer in Berlin and Düsseldorf: humanoids, lab automation cells and LLM agents that drive real hardware.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="/projects" class="btn btn-primary">
              Projects
              <svg class="size-4 stroke-current" fill="none" stroke-width="2.5" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
            </a>
            <a href="/work" class="btn btn-secondary">Experience</a>
            <a href="#contact" class="btn btn-secondary">Contact</a>
          </div>
        </div>
      </div>
    </div>

    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-32 bg-gradient-to-b from-transparent to-[rgb(var(--bg))]"></div>
  </section>

  <div class="relative">
    <div class="mx-auto max-w-screen-lg px-5 space-y-28 pb-24">

      <!-- About -->
      <section class="animate grid gap-8 md:grid-cols-[180px_1fr]">
        <div>
          <div class="label">About</div>
          <div class="mt-2 font-mono text-xs text-black/50 dark:text-white/50">
            <div>Berlin · Düsseldorf</div>
            <div>EN · DE · TR</div>
          </div>
        </div>
        <article class="!pb-0">
          <p>I build <b>robots</b> and the <b>software around them</b>: humanoid telemetry and teleoperation, service-robot retrofits, lab automation cells, and LLM agents that drive all of it.</p>
          <p>I am a robotics engineering intern at Vodafone's Innovation Campus in Düsseldorf and a master's student in Computational Engineering Science at TU Berlin, specialising in robotics and mechatronics. Before that: a robot cell for autonomous sample handling at BAM, recycling automation with UR10e and ABB arms at TU Berlin, welding robots at Koç Automotive, and a small automation start-up in Dubai.</p>
          <p>Most of what I make ends up as a tool I keep using: an AI-assisted CAD workflow on FreeCAD, a job-search agent, a Telegram assistant, and the home server that serves this page. I like problems where the hardware, the control loop and the model have to agree.</p>
        </article>
      </section>

      <!-- Capabilities -->
      <section class="animate">
        <div class="label">What I do</div>
        <h2 class="mt-2 text-2xl md:text-3xl font-bold text-black dark:text-white">From joint torque to language model</h2>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {capabilities.map((c) => (
            <div class="card p-5">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <span class="inline-flex size-8 items-center justify-center rounded border border-accent/30 bg-accent/10 text-accent">
                    <Icon name={c.icon} class="size-4" />
                  </span>
                  <div class="font-mono text-xs text-accent">{c.code}</div>
                </div>
                <div class="font-mono text-[10px] uppercase tracking-widest text-black/40 dark:text-white/40">module</div>
              </div>
              <div class="mt-3 font-semibold text-black dark:text-white">{c.title}</div>
              <p class="mt-2 text-sm">{c.text}</p>
              <ul class="mt-4 flex flex-wrap gap-1">
                {c.tags.map((t) => <li class="chip">{t}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- International Sailor: pinned while the flight route draws -->
      <section class="animate" data-route-track>
        <div class="h-[420vh]">
          <div class="sticky top-20">
            <div class="label">Being international</div>
            <h2 class="mt-2 text-2xl md:text-3xl font-bold text-black dark:text-white">International Sailor</h2>
            <p class="mt-3 max-w-2xl">Eight cities so far, from the Gulf to the Rhine. Fluent in Turkish, English and German.</p>
            <div class="mt-6">
              <WorldMap />
            </div>
            <p data-outro class="outro mt-4 max-w-2xl flex items-start gap-2">
              <span class="mt-1.5 inline-block size-2 shrink-0 rounded-full bg-warn"></span>
              <span>So many coworkers and so many projects from all around the world: Barcelona, Munich, Mannheim, Warsaw, India, China, Taiwan, California, Texas, New York, Toronto, Cape Town. Maybe yours can be the next.</span>
            </p>
          </div>
        </div>
      </section>

      <!-- Projects -->
      <section class="animate">
        <div class="flex items-end justify-between gap-4">
          <div>
            <div class="label">Projects</div>
            <h2 class="mt-2 text-2xl md:text-3xl font-bold text-black dark:text-white">Recent builds</h2>
          </div>
          <a href="/projects" class="font-mono text-xs uppercase tracking-wider text-black/60 dark:text-white/60 hover:text-accent blend">All projects →</a>
        </div>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {projects.map((project) => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))}
        </ul>
      </section>

      <!-- Stack and robots -->
      <section class="animate grid gap-10 md:grid-cols-2">
        <div>
          <div class="label">Stack</div>
          <h2 class="mt-2 text-2xl md:text-3xl font-bold text-black dark:text-white">Tools and platforms</h2>
          <div class="mt-6 flex flex-wrap gap-2">
            {stack.map((t) => (
              <span class="chip inline-flex items-center gap-1.5 !text-xs !normal-case !tracking-normal py-1 px-3 hover:border-accent hover:text-accent blend">
                {t.icon && <Icon name={t.icon} class="size-3.5" />}
                {t.name}
              </span>
            ))}
          </div>
        </div>
        <div>
          <div class="label">Robots</div>
          <h2 class="mt-2 text-2xl md:text-3xl font-bold text-black dark:text-white">Robots I have worked with</h2>
          <dl class="mt-6 divide-y divide-black/10 dark:divide-white/10 border-y border-black/10 dark:border-white/10">
            {robots.map((r) => (
              <div class="grid grid-cols-[120px_1fr] gap-3 py-3">
                <dt class="font-mono text-[11px] uppercase tracking-wider text-accent pt-1">{r.group}</dt>
                <dd class="flex flex-wrap gap-1.5">
                  {r.items.map((name) => (
                    <span class="chip !text-xs !normal-case !tracking-normal py-1 px-3 text-black dark:text-white hover:border-accent hover:text-accent blend">{name}</span>
                  ))}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      <!-- Notes -->
      <section class="animate">
        <div class="flex items-end justify-between gap-4">
          <div>
            <div class="label">Notes</div>
            <h2 class="mt-2 text-2xl md:text-3xl font-bold text-black dark:text-white">Recent write-ups</h2>
          </div>
          <a href="/blog" class="font-mono text-xs uppercase tracking-wider text-black/60 dark:text-white/60 hover:text-accent blend">All notes →</a>
        </div>
        <ul class="mt-8 grid gap-4 sm:grid-cols-2">
          {posts.map((post) => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      <!-- Contact -->
      <section id="contact" class="animate scroll-mt-24">
        <div class="card p-6 md:p-8 grid gap-6 md:grid-cols-[1fr_auto] md:items-center">
          <div>
            <div class="label">Contact</div>
            <h2 class="mt-2 text-2xl md:text-3xl font-bold text-black dark:text-white">Open to robotics work in Berlin or Düsseldorf</h2>
            <p class="mt-3 max-w-lg">Email is the fastest channel. Happy to talk humanoids, automation cells, or agents that need to touch real hardware.</p>
          </div>
          <div class="flex flex-col gap-2 font-mono text-sm">
            {SOCIALS.map(social => (
              <a href={social.HREF} target="_blank" class="group flex items-center gap-3 text-black/70 dark:text-white/70 hover:text-accent blend">
                <Icon name={social.ICON === "email" ? "lucide:mail" : `simple-icons:${social.ICON}`} class="size-4 text-black/40 dark:text-white/40 group-hover:text-accent blend" />
                <span class="w-16 text-[10px] uppercase tracking-widest text-black/40 dark:text-white/40 group-hover:text-accent/70">{social.NAME}</span>
                <span>{social.TEXT}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    </div>
  </div>
</PageLayout>
