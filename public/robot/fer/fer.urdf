<?xml version="1.0" encoding="utf-8"?>
<!-- Franka Emika Robot (FER / Panda) with Franka Hand, expanded from frankarobotics/franka_description
     robots/fer/fer.urdf.xacro (hand:=true). Apache-2.0, see LICENSE and NOTICE. Collision, inertial and
     accelerometer elements removed; visual meshes converted to meshopt-compressed GLB. -->
<robot name="fer">
  <link name="base"/>
  <joint name="fer_base_joint" type="fixed">
    <parent link="base"/>
    <child link="fer_link0"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <link name="fer_link0">
    <visual name="fer_link0_visual">
      <geometry>
        <mesh filename="meshes/link0.glb"/>
      </geometry>
    </visual>
  </link>
  <link name="fer_link1">
    <visual name="fer_link1_visual">
      <geometry>
        <mesh filename="meshes/link1.glb"/>
      </geometry>
    </visual>
  </link>
  <joint name="fer_joint1" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 0.333"/>
    <parent link="fer_link0"/>
    <child link="fer_link1"/>
    <axis xyz="0 0 1"/>
    <limit effort="87.0" lower="-2.8973" upper="2.8973" velocity="2.175"/>
    <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-2.8973" soft_upper_limit="2.8973"/>
    <dynamics D="1" K="7000" damping="0.003" friction="0.2" gear_ratio="120.0" motor_inertia="4.206399e-05" mu_coulomb="0" mu_viscous="16"/>
  </joint>
  <link name="fer_link2">
    <visual name="fer_link2_visual">
      <geometry>
        <mesh filename="meshes/link2.glb"/>
      </geometry>
    </visual>
  </link>
  <joint name="fer_joint2" type="revolute">
    <origin rpy="-1.570796326794897 0 0" xyz="0 0 0"/>
    <parent link="fer_link1"/>
    <child link="fer_link2"/>
    <axis xyz="0 0 1"/>
    <limit effort="87.0" lower="-1.7628" upper="1.7628" velocity="2.175"/>
    <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-1.7628" soft_upper_limit="1.7628"/>
    <dynamics D="1" K="7000" damping="0.003" friction="0.2" gear_ratio="120.0" motor_inertia="4.206399e-05" mu_coulomb="0" mu_viscous="16"/>
  </joint>
  <link name="fer_link3">
    <visual name="fer_link3_visual">
      <geometry>
        <mesh filename="meshes/link3.glb"/>
      </geometry>
    </visual>
  </link>
  <joint name="fer_joint3" type="revolute">
    <origin rpy="1.570796326794897 0 0" xyz="0 -0.316 0"/>
    <parent link="fer_link2"/>
    <child link="fer_link3"/>
    <axis xyz="0 0 1"/>
    <limit effort="87.0" lower="-2.8973" upper="2.8973" velocity="2.175"/>
    <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-2.8973" soft_upper_limit="2.8973"/>
    <dynamics D="1" K="7000" damping="0.003" friction="0.2" gear_ratio="120.0" motor_inertia="3.211626e-05" mu_coulomb="0" mu_viscous="16"/>
  </joint>
  <link name="fer_link4">
    <visual name="fer_link4_visual">
      <geometry>
        <mesh filename="meshes/link4.glb"/>
      </geometry>
    </visual>
  </link>
  <joint name="fer_joint4" type="revolute">
    <origin rpy="1.570796326794897 0 0" xyz="0.0825 0 0"/>
    <parent link="fer_link3"/>
    <child link="fer_link4"/>
    <axis xyz="0 0 1"/>
    <limit effort="87.0" lower="-3.0718" upper="-0.0698" velocity="2.175"/>
    <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-3.0718" soft_upper_limit="-0.0698"/>
    <dynamics D="1" K="7000" damping="0.003" friction="0.2" gear_ratio="120.0" motor_inertia="3.211626e-05" mu_coulomb="0" mu_viscous="16"/>
  </joint>
  <link name="fer_link5">
    <visual name="fer_link5_visual">
      <geometry>
        <mesh filename="meshes/link5.glb"/>
      </geometry>
    </visual>
  </link>
  <joint name="fer_joint5" type="revolute">
    <origin rpy="-1.570796326794897 0 0" xyz="-0.0825 0.384 0"/>
    <parent link="fer_link4"/>
    <child link="fer_link5"/>
    <axis xyz="0 0 1"/>
    <limit effort="12.0" lower="-2.8973" upper="2.8973" velocity="2.61"/>
    <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-2.8973" soft_upper_limit="2.8973"/>
    <dynamics D="1" K="7000" damping="0.003" friction="0.2" gear_ratio="80.0" motor_inertia="3.211626e-05" mu_coulomb="0" mu_viscous="16"/>
  </joint>
  <link name="fer_link6">
    <visual name="fer_link6_visual">
      <geometry>
        <mesh filename="meshes/link6.glb"/>
      </geometry>
    </visual>
  </link>
  <joint name="fer_joint6" type="revolute">
    <origin rpy="1.570796326794897 0 0" xyz="0 0 0"/>
    <parent link="fer_link5"/>
    <child link="fer_link6"/>
    <axis xyz="0 0 1"/>
    <limit effort="12.0" lower="-0.0175" upper="3.7525" velocity="2.61"/>
    <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-0.0175" soft_upper_limit="3.7525"/>
    <dynamics D="1" K="7000" damping="0.003" friction="0.2" gear_ratio="80.0" motor_inertia="3.211626e-05" mu_coulomb="0" mu_viscous="16"/>
  </joint>
  <link name="fer_link7">
    <visual name="fer_link7_visual">
      <geometry>
        <mesh filename="meshes/link7.glb"/>
      </geometry>
    </visual>
  </link>
  <joint name="fer_joint7" type="revolute">
    <origin rpy="1.570796326794897 0 0" xyz="0.088 0 0"/>
    <parent link="fer_link6"/>
    <child link="fer_link7"/>
    <axis xyz="0 0 1"/>
    <limit effort="12.0" lower="-2.8973" upper="2.8973" velocity="2.61"/>
    <safety_controller k_position="100.0" k_velocity="40.0" soft_lower_limit="-2.8973" soft_upper_limit="2.8973"/>
    <dynamics D="1" K="7000" damping="0.003" friction="0.2" gear_ratio="80.0" motor_inertia="3.211626e-05" mu_coulomb="0" mu_viscous="16"/>
  </joint>
  <link name="fer_link8"/>
  <joint name="fer_joint8" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.107"/>
    <parent link="fer_link7"/>
    <child link="fer_link8"/>
  </joint>
  <joint name="fer_hand_joint" type="fixed">
    <parent link="fer_link8"/>
    <child link="fer_hand"/>
    <origin rpy="0 0 -0.7853981633974483" xyz="0 0 0"/>
  </joint>
  <link name="fer_hand">
    <visual name="fer_hand_visual">
      <geometry>
        <mesh filename="meshes/hand.glb"/>
      </geometry>
    </visual>
  </link>
  <link name="fer_hand_tcp"/>
  <joint name="fer_hand_tcp_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.1034"/>
    <parent link="fer_hand"/>
    <child link="fer_hand_tcp"/>
  </joint>
  <link name="fer_leftfinger">
    <visual name="fer_leftfinger_visual">
      <geometry>
        <mesh filename="meshes/finger.glb"/>
      </geometry>
    </visual>
  </link>
  <link name="fer_rightfinger">
    <visual name="fer_rightfinger_visual">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="meshes/finger.glb"/>
      </geometry>
    </visual>
  </link>
  <joint name="fer_finger_joint1" type="prismatic">
    <parent link="fer_hand"/>
    <child link="fer_leftfinger"/>
    <origin rpy="0 0 0" xyz="0 0 0.0584"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" lower="0.0" upper="0.04" velocity="0.2"/>
    <dynamics damping="0.3"/>
  </joint>
  <joint name="fer_finger_joint2" type="prismatic">
    <parent link="fer_hand"/>
    <child link="fer_rightfinger"/>
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0.0584"/>
    <axis xyz="0 1 0"/>
    <limit effort="100" lower="0.0" upper="0.04" velocity="0.2"/>
    <mimic joint="fer_finger_joint1"/>
    <dynamics damping="0.3"/>
  </joint>
</robot>
